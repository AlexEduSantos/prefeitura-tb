FROM node:22-alpine

WORKDIR /usr/src/app

# Habilita e configura o pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

COPY package.json pnpm-lock.yaml* ./

RUN pnpm install

COPY . .

# Gera o client do Prisma
RUN pnpm prisma generate

EXPOSE 3001

CMD ["pnpm", "run", "start:dev"]
