generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========
enum ArticleStatus {
  rascunho
  publicado
  arquivado
  expirado
  excluido
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum PopupStatus {
  rascunho
  publicado
  arquivado
  expirado
  excluido
}

enum PopupType {
  modal
  bar
  corner
  fullscreen
}

enum UserRole {
  ADMIN
  PUBLISHER
  MANAGER
  USER
}

// ========== MODELS ==========
model User {
  id        String      @id @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String      @unique
  name      String
  email     String      @unique
  password  String
  avatar    String?
  phone     String?
  entityId  String      @db.Uuid
  entity    Entity      @relation(fields: [entityId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  role      UserRole    @default(USER)
  galleries Galleries[]
  popups    Popups[]
  services  Services[]
  pages     Page[]

  articleAuthor Article[] @relation("articleAuthor")
  articleEditor Article[] @relation("articleEditor")

  @@map("user")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
  @@map("session")
}

model Entity {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String
  createdAt DateTime    @default(now())
  pages     Page[]
  users     User[]
  articles  Article[]
  popups    Popups[]
  galleries Galleries[]
  services  Services[]

  @@map("entity")
}

model Page {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  slug      String
  content   Json
  published Boolean @default(false)

  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@unique([entityId, slug])
}

model Article {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  headline                 String?       @db.VarChar(500)
  body                     Json
  slug                     String        @unique
  type                     String        @default("article")
  status                   ArticleStatus @default(rascunho)
  publicationDate          DateTime?
  expirationDate           DateTime?
  featured                 Boolean       @default(false)
  createdAt                DateTime      @default(now()) @db.Timestamp
  updatedAt                DateTime      @updatedAt @db.Timestamp
  seoTitle                 String?
  seoDescription           String?
  seoKeywords              String?
  allowComments            Boolean       @default(true)
  tags                     String[]
  visibility               String        @default("public")
  galleryId                String?       @db.Uuid
  gallery                  Galleries?    @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  socialPreviewTitle       String?
  socialPreviewImage       String?
  socialPreviewDescription String?

  authorId String  @db.Uuid
  author   User    @relation("articleAuthor", fields: [authorId], references: [id])
  editorId String? @db.Uuid
  editor   User?   @relation("articleEditor", fields: [editorId], references: [id])

  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  coverId String @db.Uuid
  cover   Media  @relation("articleCover", fields: [coverId], references: [id])
}

model Media {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  altText     String?
  description String?     @db.VarChar(1000)
  type        String
  key         String?
  url         String?
  fileSize    Int?
  mimeType    String?
  width       Int?
  height      Int?
  tags        String[]
  status      MediaStatus @default(pending)
  createdAt   DateTime    @default(now()) @db.Timestamp
  updatedAt   DateTime    @updatedAt @db.Timestamp

  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String? @db.Uuid

  popups        Popups[]       @relation("popupImage")
  galleryMedias GalleryMedia[]
  services      Services[]     @relation("serviceImage")

  // Articles relations
  articleCover Article[] @relation("articleCover")

  // Stories relations
  storiesCover Stories[]     @relation("storiesCover")
  storiesItems StoriesItem[] @relation("storiesItemMedia") // ✅ Nome adicionado
}

model Folder {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  path String @unique

  parentId String?  @db.Uuid
  parent   Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderToFolder")

  media Media[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@map("folder")
}

enum GalleryType {
  slider
  sliderVertical
  grid
  carousel
}

model Galleries {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  active                Boolean     @default(true)
  createdAt             DateTime    @default(now()) @db.Timestamp // ✅ Adicionado @db.Timestamp
  updatedAt             DateTime    @updatedAt @db.Timestamp // ✅ Adicionado @db.Timestamp
  galleryType           GalleryType @default(slider)
  galleryAutoplay       Boolean     @default(true)
  galleryInterval       Int         @default(5000)
  galleryShowThumbnails Boolean     @default(true)

  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  // ✅ Mantido apenas GalleryMedia como relação N:N explícita
  slides GalleryMedia[]

  // ❌ Removido: medias Media[] (estava inconsistente)
  articles Article[]

  @@index([entityId, active])
}

model GalleryMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order     Int      @default(0)
  caption   String?
  link      String?
  createdAt DateTime @default(now()) @db.Timestamp // ✅ Adicionado
  updatedAt DateTime @updatedAt @db.Timestamp // ✅ Adicionado

  galleryId String    @db.Uuid
  gallery   Galleries @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  mediaId String @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([galleryId, order])
  @@index([galleryId])
}

model Popups {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  link            String?
  active          Boolean     @default(true)
  displayTime     Int         @default(5)
  status          PopupStatus @default(rascunho)
  type            PopupType   @default(modal)
  position        String?
  closeButton     Boolean     @default(true)
  priority        Int         @default(0)
  publicationDate DateTime?
  expirationDate  DateTime?
  createdAt       DateTime    @default(now()) @db.Timestamp // ✅ Adicionado
  updatedAt       DateTime    @updatedAt @db.Timestamp // ✅ Adicionado

  // ✅ Corrigido: Relação nomeada
  imageId String @db.Uuid
  image   Media  @relation("popupImage", fields: [imageId], references: [id])

  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityId, active, status, publicationDate, expirationDate])
}

model Services {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  link      String   @unique
  altText   String?
  createdAt DateTime @default(now()) @db.Timestamp // ✅ Adicionado
  updatedAt DateTime @updatedAt @db.Timestamp // ✅ Adicionado

  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  // ✅ Corrigido: Relação nomeada
  image   Media  @relation("serviceImage", fields: [imageId], references: [id])
  imageId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid
}

model Stories {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  alt         String?
  createdAt   DateTime @default(now()) @db.Timestamp // ✅ Adicionado
  updatedAt   DateTime @updatedAt @db.Timestamp // ✅ Adicionado

  coverId String @db.Uuid
  cover   Media  @relation("storiesCover", fields: [coverId], references: [id])

  items StoriesItem[]
}

model StoriesItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order     Int      @default(0)
  caption   String?
  createdAt DateTime @default(now()) @db.Timestamp // ✅ Adicionado
  updatedAt DateTime @updatedAt @db.Timestamp // ✅ Adicionado

  storyId String  @db.Uuid
  story   Stories @relation(fields: [storyId], references: [id], onDelete: Cascade)

  // ✅ Corrigido: Relação nomeada
  mediaId String @db.Uuid
  media   Media  @relation("storiesItemMedia", fields: [mediaId], references: [id])

  @@unique([storyId, order])
}
