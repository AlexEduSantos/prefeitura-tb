generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  previewFeatures     = ["fullTextSearchPostgres"]
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ========== ENUMS ==========
enum ArticleStatus {
  rascunho
  programado
  publicado
  arquivado
  expirado
  excluido
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum PopupStatus {
  rascunho
  agendado
  publicado
  arquivado
  expirado
  excluido
}

enum PopupType {
  modal
  bar
  corner
  fullscreen
}

enum UserRole {
  ADMIN
  PUBLISHER
  MANAGER
  USER
}

enum OrganizationTypes {
  prefeitura
  secretaria
  divisão
  seção
  conselho
  projeto
}

// ========== MODELS ==========
model Organization {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title   String
  acronym String?
  type    OrganizationTypes @default(secretaria)
  active  Boolean           @default(true)

  // Hierarquia administrativa
  parentId String?        @db.Uuid
  parent   Organization?  @relation("OrgHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Organization[] @relation("OrgHierarchy")

  // Espaço de URL padrão associado (ex: Secretaria de Educação -> /educacao)
  defaultSpaceId String? @db.Uuid
  defaultSpace   Space?  @relation("OrgDefaultSpace", fields: [defaultSpaceId], references: [id], onDelete: SetNull)

  // Conteúdos pertencentes a esta organização
  users     User[]
  articles  Article[]
  pages     Page[]
  galleries Galleries[]
  popups    Popups[]
  services  Services[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp
  menus     Menu[]

  @@map("organization")
}

model Space {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String  @unique
  title       String
  description String?

  organizations Organization[] @relation("OrgDefaultSpace")
  pages         Page[]
  galleries     Galleries[]
  popups        Popups[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp
  menus     Menu[]

  @@map("space")
}

model Category {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  slug        String  @unique
  description String?

  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  articles Article[] @relation("ArticleCategories")

  createdAt DateTime   @default(now()) @db.Timestamp
  updatedAt DateTime   @updatedAt @db.Timestamp
  menuItems MenuItem[]

  @@map("category")
}

model User {
  id       String   @id @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username String   @unique
  name     String
  email    String   @unique
  password String
  avatar                   String?
  phone                    String?
  active                   Boolean   @default(false)
  activationTokenHash      String?
  activationTokenExpiresAt DateTime? @db.Timestamp
  activationTokenMaxUses   Int       @default(1)
  activationTokenUsedCount Int       @default(0)
  role                     UserRole  @default(USER)

  // Vínculo organizacional (1:1)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime? @db.Timestamp

  galleries Galleries[]
  popups    Popups[]
  services  Services[]
  pages     Page[]

  articleAuthor           Article[]         @relation("articleAuthor")
  articleEditor           Article[]         @relation("articleEditor")
  auditLogs               AuditLog[]
  officialGazettesCreator OfficialGazette[] @relation("GazetteCreator") // usuário criador
  officialGazettesEditor  OfficialGazette[] @relation("GazetteUpdater") // usuário editor

  @@map("user")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
  @@map("session")
}

model Page {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  slug           String
  content        Json
  description    String?
  published      Boolean   @default(false)
  workflowStatus String    @default("aprovado")
  pendingAction  Json?
  approvedById   String?   @db.Uuid
  approvedAt     DateTime? @db.Timestamp
  deletedAt      DateTime? @db.Timestamp

  // Roteamento: /[spaceSlug]/[slug] ou /[slug] se spaceId for null
  spaceId String? @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id])

  // Responsável organizacional
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id])
  menuItems MenuItem[]

  @@unique([spaceId, slug])
  @@map("page")
}

model Article {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  headline                 String?       @db.VarChar(500)
  body                     Json
  slug                     String        @unique
  type                     String        @default("article")
  status                   ArticleStatus @default(rascunho)
  publicationDate          DateTime?
  expirationDate           DateTime?
  featured                 Boolean       @default(false)
  createdAt                DateTime      @default(now()) @db.Timestamp
  updatedAt                DateTime      @updatedAt @db.Timestamp
  seoTitle                 String?
  seoDescription           String?
  seoKeywords              String?
  allowComments            Boolean       @default(true)
  tags                     String[]
  visibility               String        @default("public")
  workflowStatus           String        @default("aprovado")
  pendingAction            Json?
  approvedById             String?       @db.Uuid
  approvedAt               DateTime?     @db.Timestamp
  deletedAt                DateTime?     @db.Timestamp
  galleryId                String?       @db.Uuid
  gallery                  Galleries?    @relation(fields: [galleryId], references: [id], onDelete: SetNull)
  socialPreviewTitle       String?
  socialPreviewImage       String?
  socialPreviewDescription String?

  // Vínculo Organizacional (RBAC)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Taxonomia Editorial
  categories Category[] @relation("ArticleCategories")

  authorId String  @db.Uuid
  author   User    @relation("articleAuthor", fields: [authorId], references: [id])
  editorId String? @db.Uuid
  editor   User?   @relation("articleEditor", fields: [editorId], references: [id])

  coverId String @db.Uuid
  cover   Media  @relation("articleCover", fields: [coverId], references: [id])

  @@map("article")
}

model Media {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  altText     String?
  description String?     @db.VarChar(1000)
  type        String
  key         String?
  url         String?
  fileSize    Int?
  mimeType    String?
  width         Int?
  height        Int?
  tags          String[]
  extractedText String?     @db.Text
  status        MediaStatus @default(pending)
  createdAt   DateTime    @default(now()) @db.Timestamp
  updatedAt   DateTime    @updatedAt @db.Timestamp

  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId String? @db.Uuid

  popups        Popups[]       @relation("popupImage")
  galleryMedias GalleryMedia[]
  services      Services[]     @relation("serviceImage")

  // Articles relations
  articleCover Article[] @relation("articleCover")

  // Stories relations
  storiesCover Stories[]     @relation("storiesCover")
  storiesItems StoriesItem[] @relation("storiesItemMedia")

  @@map("media")
}

model Folder {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title String
  path  String @unique

  parentId String?  @db.Uuid
  parent   Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderToFolder")

  media Media[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@map("folder")
}

enum GalleryType {
  slider
  sliderVertical
  grid
  carousel
}

model Galleries {
  id                    String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                 String
  active                Boolean     @default(true)
  workflowStatus        String      @default("aprovado")
  pendingAction         Json?
  approvedById          String?     @db.Uuid
  approvedAt            DateTime?   @db.Timestamp
  deletedAt             DateTime?   @db.Timestamp
  createdAt             DateTime    @default(now()) @db.Timestamp
  updatedAt             DateTime    @updatedAt @db.Timestamp
  galleryType           GalleryType @default(slider)
  galleryAutoplay       Boolean     @default(true)
  galleryInterval       Int         @default(5000)
  galleryShowThumbnails Boolean     @default(true)

  // Espaço de exibição: null = portal inteiro / preenchido = restrito ao space
  spaceId String? @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Gestor da galeria (RBAC)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  // GalleryMedia como relação N:N explícita
  slides GalleryMedia[]

  articles Article[]

  @@index([organizationId, active])
  @@index([spaceId, active])
  @@map("gallery")
}

model GalleryMedia {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order     Int      @default(0)
  caption   String?
  link      String?
  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  galleryId String    @db.Uuid
  gallery   Galleries @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  mediaId String @db.Uuid
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([galleryId, order])
  @@index([galleryId])
  @@map("gallery_media")
}

model Popups {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  link            String?
  active          Boolean     @default(true)
  workflowStatus  String      @default("aprovado")
  pendingAction   Json?
  approvedById    String?     @db.Uuid
  approvedAt      DateTime?   @db.Timestamp
  deletedAt       DateTime?   @db.Timestamp
  displayTime     Int         @default(5)
  status          PopupStatus @default(rascunho)
  type            PopupType   @default(modal)
  position        String?
  closeButton     Boolean     @default(true)
  priority        Int         @default(10)
  publicationDate DateTime?
  expirationDate  DateTime?
  createdAt       DateTime    @default(now()) @db.Timestamp
  updatedAt       DateTime    @updatedAt @db.Timestamp

  // Espaço de exibição: null = portal inteiro / preenchido = restrito ao space
  spaceId String? @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  // Gestor do popup (RBAC)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  imageId String @db.Uuid
  image   Media  @relation("popupImage", fields: [imageId], references: [id])

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  @@index([organizationId, active, status])
  @@index([spaceId, active, status])
  @@map("popup")
}

model Services {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  link           String    @unique
  altText        String?
  active         Boolean   @default(true)
  workflowStatus String    @default("aprovado")
  pendingAction  Json?
  approvedById   String?   @db.Uuid
  approvedAt     DateTime? @db.Timestamp
  deletedAt      DateTime? @db.Timestamp
  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt @db.Timestamp
  featured    Boolean  @default(false)
  description String?  @db.VarChar(1000)

  // Gestor do serviço (RBAC)
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  image   Media  @relation("serviceImage", fields: [imageId], references: [id])
  imageId String @db.Uuid

  user   User   @relation(fields: [userId], references: [id])
  userId String @db.Uuid

  @@map("service")
}

model Stories {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  order       Int?     @default(0)
  createdAt   DateTime @default(now()) @db.Timestamp
  updatedAt   DateTime @updatedAt @db.Timestamp

  coverId String @db.Uuid
  cover   Media  @relation("storiesCover", fields: [coverId], references: [id])

  items StoriesItem[]

  @@map("story")
}

model StoriesItem {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order          Int       @default(0)
  caption        String?
  link           String?
  createdAt      DateTime  @default(now()) @db.Timestamp
  updatedAt      DateTime  @updatedAt @db.Timestamp
  publishedDate  DateTime?
  expirationDate DateTime?

  storyId String  @db.Uuid
  story   Stories @relation(fields: [storyId], references: [id], onDelete: Cascade)

  mediaId String @db.Uuid
  media   Media  @relation("storiesItemMedia", fields: [mediaId], references: [id])

  @@unique([storyId, order])
  @@map("story_item")
}

enum MenuLocation {
  header
  footer
  sidebar
  mobile
}

model Menu {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  location    MenuLocation
  description String?
  active      Boolean      @default(true)

  // Onde aparece (contexto de URL). null = global
  spaceId String? @db.Uuid
  space   Space?  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  // Quem gerencia (RBAC). null = admin global
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id])

  items MenuItem[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@unique([location, spaceId]) // um menu por local em cada espaço
  @@index([organizationId])
  @@map("menu")
}

model MenuItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label       String
  description String?
  icon        String?
  visible     Boolean @default(true)
  order       Int     @default(0)

  // Destino — no máximo um dos três
  pageId String? @db.Uuid
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  categoryId String?   @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  url String? // link externo, âncora, e-mail, tel:

  // Hierarquia
  parentId String?    @db.Uuid
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuHierarchy")

  // Pertence a um menu
  menuId String @db.Uuid
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@index([menuId, parentId, order])
  @@map("menu_item")
}

model SiteSettings {
  id              String  @id @default("singleton") @db.VarChar(20) // Força ser único
  siteName        String  @default("Prefeitura Municipal")
  siteDescription String? // Para SEO (meta description)

  // Identidade Visual
  logoUrl                  String? // URL da imagem no MinIO
  faviconUrl               String? // URL do favicon
  primaryColor             String  @default("#1e3a8a") // Hex da cor principal
  primaryForegroundColor   String? @default("#ffffff")
  secondaryColor           String  @default("#f59e0b") // Hex da cor secundária
  secondaryForegroundColor String? @default("#000000")
  themeColors              Json? // Objeto com outras cores (ex: { "header": "#...", "footer": "#..." })

  // Endereço e Contato
  addressStreet String?
  addressNumber String?
  addressCity   String? @default("Telêmaco Borba")
  addressState  String? @default("PR")
  addressZip    String?
  phone         String?
  email         String?
  workingHours  String?
  visits        Int     @default(0)

  // Redes Sociais
  socialLinks Json? // ex: { "facebook": "url", "instagram": "url" }

  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamp

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model OfficialGazette {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Identificação Básica
  title       String // Ex: "Boletim Oficial nº 1542/2026"
  edition     String? // Ex: "1542" (Útil para separar do título, se necessário)
  description String? // Resumo do que contém nesta edição

  // Datas e Prazos (Crucial para validade jurídica)
  publicationDate DateTime @db.Date // A data que consta no documento

  // Arquivos
  fileUrl     String // URL do PDF no MinIO
  fileSize    Int? // Tamanho em bytes (útil para exibir "Download 2.5MB")
  pageCount   Int? // Número de páginas
  contentText String? @db.Text // Texto extraído do PDF para Full-Text Search

  // Controle de Auditoria (Quem fez o quê)
  createdById String @db.Uuid
  createdBy   User   @relation("GazetteCreator", fields: [createdById], references: [id])

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("GazetteUpdater", fields: [updatedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@index([publicationDate(sort: Desc)])
  @@index([title])
  @@map("official_gazette")
}
