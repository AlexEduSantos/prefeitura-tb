// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username  String   @unique
  name      String
  email     String   @unique
  password  String
  avatar    String?
  phone     String?
  entityId  String   @db.Uuid
  entity    Entity   @relation(fields: [entityId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      UserRole @default(USER)

  @@map("user")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], name: "IDX_session_expire")
  @@map("session")
}

enum UserRole {
  ADMIN
  PUBLISHER
  USER
}

model Entity {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String // Ex: "Secretaria de Educação"
  slug      String // Ex: "educacao" (usado na URL /secretarias/educacao)
  createdAt DateTime  @default(now())
  pages     Page[]
  users     User[]
  articles  Article[]
  menus     Menu[]

  @@map("entity")
}

model Page {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String // Ex: "Inscrições Cursos Técnicos"
  slug      String // Ex: "inscricoes-cursos" -> gerará /educacao/inscricoes-cursos
  content   Json // Onde você salvará a estrutura de blocos do seu Page Builder
  published Boolean @default(false)

  // O elo com a Secretaria (Atributo para o ABAC)
  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  // NOVO: Relacionamento reverso com os itens de menu
  menuItems MenuItem[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  @@unique([entityId, slug]) // Garante que não haja duas páginas com o mesmo slug na MESMA secretaria
}

model Menu {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String // Ex: "Menu Principal" ou "Links Úteis"
  location String // Identificador interno. Ex: "header", "footer", "sidebar"

  // O menu também pertence a uma Secretaria
  entityId String @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id])

  items MenuItem[]

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp

  // Garante que uma secretaria não tenha dois menus marcados como "header" ao mesmo tempo
  @@unique([entityId, location])
}

model MenuItem {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label String // O texto que aparece no botão. Ex: "Fale Conosco"
  order Int     @default(0) // Para ordenar os links arrastando e soltando
  url   String? // Usado APENAS se for um link externo ou âncora (ex: https://google.com)

  // Relacionamento com o Menu Pai
  menuId String @db.Uuid
  menu   Menu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  // Relacionamento OPCIONAL com uma Página interna
  // onDelete: SetNull -> Se a página for apagada, o link não quebra o sistema, apenas perde o destino
  pageId String? @db.Uuid
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  // Relacionamento recursivo (Para criar submenus / dropdowns)
  parentId String?    @db.Uuid
  parent   MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuItem[] @relation("MenuHierarchy")

  createdAt DateTime @default(now()) @db.Timestamp
  updatedAt DateTime @updatedAt @db.Timestamp
}

model Article {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title                    String
  headline                 String?   @db.VarChar(500)
  entityId                 String    @db.Uuid
  entity                   Entity    @relation(fields: [entityId], references: [id])
  cover                    String?   @db.Text
  body                     String
  slug                     String    @unique
  type                     String    @default("article")
  status                   String    @default("rascunho")
  publicationDate          DateTime?
  expirationDate           DateTime?
  featured                 Boolean   @default(false)
  author                   String?
  editor                   String?
  createdAt                DateTime  @default(now()) @db.Timestamp
  updatedAt                DateTime  @default(now()) @db.Timestamp
  seoTitle                 String?
  seoDescription           String?
  seoKeywords              String?
  allowComments            Boolean   @default(true)
  tags                     String[]
  visibility               String    @default("public") // "public", "internal", "restricted"
  galleryImages            String[]
  galleryAutoplay          Boolean   @default(false)
  galleryInterval          Int       @default(5000)
  galleryShowThumbnails    Boolean   @default(true)
  socialPreviewTitle       String?
  socialPreviewImage       String?
  socialPreviewDescription String?
}

model Media {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  alt_text    String?
  description String?  @db.VarChar(1000)
  type        String // "image", "video", "audio", "document"
  key         String? // Caminho/Chave no S3 (Ex: "images/2026/05/foto.webp")
  url         String? // Opcional, ou mantido como virtual se usarmos extensions
  file_size   Int?
  mime_type   String?
  width       Int?
  height      Int?
  tags        String[]
  status      String   @default("pending") // "pending", "processing", "ready", "failed"
  created_at  DateTime @default(now()) @db.Timestamp
  updated_at  DateTime @default(now()) @db.Timestamp
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId    String?  @db.Uuid
}

model Folder {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  path      String   @unique // The full logical prefix (e.g. "documents/capas")
  parentId  String?  @db.Uuid
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderToFolder")
  media     Media[]
  createdAt DateTime @default(now()) @db.Timestamp

  @@map("folder")
}
